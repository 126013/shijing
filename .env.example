# ---- 可选：接入线上全量诗词接口（不配置则使用仓库内置精选集） ----
# 期望契约：GET {base}/api/poems?q=&dynasty=&theme=&author=&page=&pageSize=
#           返回 { items, total, page, pageSize }
#          GET {base}/api/poems/{id}  -> { ...poem, lines }
# POETRY_API_BASE=http://175.24.226.170:3000

# ---- 可选：豆包（火山方舟）语音合成 ----
